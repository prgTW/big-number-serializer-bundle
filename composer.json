{
    "name": "prgtw/big-number-serializer-bundle",
    "description": "Bundle for serializing BigNumber classes to/from string representation using JmsSerializer",
    "keywords": [
        "symfony",
        "bundle",
        "brick",
        "math",
        "serializer"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Tomasz Wójcik",
            "email": "tomasz.prgtw.wojcik@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "prgTW\\BigNumberSerializerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "prgTW\\BigNumberSerializerBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "symfony/config": "^2 || ^3 || ^4 || ^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^2 || ^3 || ^4 || ^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^2 || ^3 || ^4 || ^5.4 || ^6.4 || ^7.0",
        "jms/serializer": "^1 || ^3",
        "jms/serializer-bundle": "^1 || ^2 || ^3 || ^4 || ^5",
        "brick/math": "^0.9.2 || ~0.10.0 || ~0.11.0 || ~0.12.0 || ~0.13.0 || ~0.14.0 || ~0.15.0 || ~0.16.0 || ~0.17.0 || ~0.18.0 || ~0.19.0 || ~0.20.0 || ^1.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^9.5",
        "doctrine/annotations": "^1.13 || ^2.0",
        "symfony/yaml": "^2 || ^3 || ^4 || ^5.4 || ^6.4 || ^7.0"
    },
    "scripts": {
        "test": [
            "vendor/bin/phpunit -c phpunit.xml.dist"
        ]
    }
}
